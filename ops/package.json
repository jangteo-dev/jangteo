{
  "name": "giwa-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GIWA farming loop, sentinel, Gye keeper and Telegram control bot",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "once": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts $(ls src/private/test/*.test.ts 2>/dev/null)",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "grammy": "^1.46.0",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "playwright": "1.61.0",
    "typescript": "^5.9.3"
  }
}
